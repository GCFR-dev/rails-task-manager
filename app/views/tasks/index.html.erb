<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Tasks</h1>
  <%= link_to "New task", new_task_path, class: "btn btn-primary" %>
</div>

<ul class="list-group">
  <% @tasks.each do |task| %>
    <li class="list-group-item d-flex justify-content-between align-items-center">
      <span>
        <% if task.completed %>
          <i class="fa-regular fa-square-check text-success"></i>
        <% else %>
          <i class="fa-regular fa-square"></i>
        <% end %>
        <%= link_to task.title, task_path(task), class: "ms-2 text-decoration-none" %>
      </span>
      <%= link_to "Delete", task_path(task), class: "btn btn-sm btn-outline-danger", data: { turbo_method: :delete, turbo_confirm: "Are you sure?" } %>
    </li>
  <% end %>
</ul>
